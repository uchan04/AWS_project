# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋되지 않는다.
# 키를 추가하면 Amplify 콘솔의 환경변수에도 같은 키를 등록해야 한다. (소유자: E)

# RDS Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/welli?schema=public"

# Cognito (us-east-1 기준. 실제 리전으로 맞춘다)
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
# Hosted UI 도메인 (호스트명만, https:// 없이). Google 로그인(app/api/auth/google, callback)에 쓴다.
# 비어 있으면 Google 로그인 버튼이 503을 반환하고 이메일 로그인만 동작한다.
COGNITO_DOMAIN=""

# Bedrock — 모델 ID는 콘솔 Model catalog에서 복사한다
BEDROCK_REGION="us-east-1"
BEDROCK_MODEL_ID=""
BEDROCK_VISION_MODEL_ID=""

# S3 (사진 미션 업로드, 글 이미지). 사용자 업로드만 여기를 쓴다.
S3_BUCKET=""
# 2026-08-22: 이 키를 읽는 코드는 없다. 펫·치장 그림 30장은 public/art/ 아래에 구워져 있고
# lib/assets.ts가 거기서 읽는다(CloudFront가 모든 경로에 403을 줬다). amplify.yml 목록에 남아
# 있어 키만 두고, 로컬에서는 빈 값으로 둔다.
CLOUDFRONT_DOMAIN=""

# 배포 도메인. Google 로그인 redirect_uri와 OG 이미지의 절대 URL을 만드는 데 쓴다
# (lib/oauth.ts, app/layout.tsx). 로컬은 비워 둔다 — 요청 URL에서 알아낸다.
# 배포에서는 amplify.yml이 값이 없으면 Amplify 기본 도메인으로 채운다.
APP_ORIGIN=""

# 개발 편의용. true면 lib/auth.ts가 Cognito 검증을 건너뛰고 고정 유저를 반환한다.
# 배포 환경에서는 절대 true로 두지 않는다.
DEV_AUTH_BYPASS="true"

# 자체 DB 계정 세션 서명 키. openssl rand -base64 32로 생성. 로컬·배포 각각 다른 값 사용.
# 이메일 로그인(app/api/auth/login)이 필요하면 반드시 설정. 비어 있으면 로그인 시 500 에러.
SESSION_SECRET=""
