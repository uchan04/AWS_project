# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋되지 않는다.
# 키를 추가하면 Amplify 콘솔의 환경변수에도 같은 키를 등록해야 한다. (소유자: E)

# RDS Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/isol?schema=public"

# Cognito (us-east-1 기준. 실제 리전으로 맞춘다)
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""

# Bedrock — 모델 ID는 콘솔 Model catalog에서 복사한다
BEDROCK_REGION="us-east-1"
BEDROCK_MODEL_ID=""

# S3 (사진 미션 업로드, 펫·치장 이미지)
S3_BUCKET=""
CLOUDFRONT_DOMAIN=""

# 개발 편의용. true면 lib/auth.ts가 Cognito 검증을 건너뛰고 고정 유저를 반환한다.
# 배포 환경에서는 절대 true로 두지 않는다.
DEV_AUTH_BYPASS="true"
