// 5인이 공유하는 유일한 계약 파일이다.
// 변경 절차는 CLAUDE.md의 "공유 파일" 절을 따른다. 브랜치에서 고치지 않는다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자에게 보이는 대분류. 화면에는 유형 이름을 쓰지 않고 동물·종족만 보여준다.
enum TypeCode {
  INDEPENDENT_LOW_INCOME // 독립거주-저소득형 / 고양잇과 / 고양이
  HEALTH_EMOTION // 건강·정서취약형 / 개과 / 여우
  FAMILY_LIVING // 가족동거형 / 곰과 / 곰
}

// Post.galleryType 전용. TypeCode 3종 + 커뮤니티 "전체" 탭 글쓰기용 ALL.
// 값 이름은 TypeCode와 동일하게 맞춘다 — 기존 데이터가 이름 그대로 매핑된다.
enum GalleryType {
  INDEPENDENT_LOW_INCOME
  HEALTH_EMOTION
  FAMILY_LIVING
  ALL
}

// 모임 상태. 관리자가 개설하면 OPEN, 관리자가 결성확인하면 CONFIRMED.
// OPEN일 때만 신청·취소가 가능하다.
enum MeetupStatus {
  OPEN
  CONFIRMED
  CANCELED
}

// 관리자 전용 세부유형. 연구보고서 9유형에서 경계선지능청년을 뺀 8개다.
// (IQ 71~84는 자기보고로 측정할 수 없고 묻는 것 자체가 낙인이다)
// 절대 화면에 노출하지 않는다. 관리자 화면은 TypeCode × SubTypeCode 교차표로 본다.
enum SubTypeCode {
  AFTERCARE_YOUTH // 자립준비청년
  FAMILY_CAREGIVER // 가족돌봄청년
  MIGRANT_YOUTH // 지역이주청년
  HEALTH_FRAGILE // 건강취약형
  DEBT_INDEPENDENT // 독립생계채무형
  FINANCIAL_FRAGILE // 금융취약청년
  JOBLESS_POOR // 미취업빈곤형
  FAMILY_DEPENDENT // 가족의존형
}

enum Adjective {
  QUIET // 조용한
  WARM // 다정한
  DILIGENT // 부지런한
  EASYGOING // 느긋한
}

enum MissionScope {
  DAILY
  STAGE
}

enum Slot {
  HAT
  SCARF
  BACKGROUND
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum EffectType {
  NONE
  SEED
  SHARD
  AFFINITY
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id         String @id @default(cuid())
  cognitoSub String @unique

  // 자체 DB 계정용(A가 E 합의로 추가, 2026-08-21). Cognito로 가입한 계정은 둘 다 null이다.
  // 자체 계정은 cognitoSub에 "local:<cuid>"를 넣어 Cognito sub(UUID)와 겹치지 않게 한다.
  // passwordHash는 lib/password.ts의 scrypt 형식("scrypt$<salt>$<hash>")이다. 평문은 저장하지 않는다.
  email        String? @unique
  passwordHash String?

  // 진단 완료 시 표시명(형용사 + 동물)으로 자동 세팅한다.
  // 이후 유저가 프로필에서 변경할 수 있다. 유니크 제약을 두지 않는다.
  nickname String @default("")

  // typeCode는 종족(과)을 결정하며 재진단 외에는 변경되지 않는다.
  typeCode  TypeCode?
  adjective Adjective?

  // 관리자 통계용. API 응답과 화면에 절대 내보내지 않는다.
  subTypeCode SubTypeCode?

  // 오프라인 모임 개설·결성확인 권한. 부여는 DB에서 직접 한다.
  isAdmin Boolean @default(false)

  level          Int @default(1)
  exp            Int @default(0)
  evolutionStage Int @default(1) // 1~4 (알·아기·청소년·성체. PetSkin.stageCount가 상한)

  seeds      Int @default(0)
  starShards Int @default(0)
  affinity   Int @default(0)

  // 친밀도 일일 지급 상한(100) 계산용. 접속 시점에 날짜를 비교해 리셋한다.
  affinityToday     Int       @default(0)
  affinityTodayDate DateTime?

  activePetSkinId String?
  activePetSkin   PetSkin? @relation("ActiveSkin", fields: [activePetSkinId], references: [id])

  streakCount    Int       @default(0)
  lastStreakDate DateTime?

  lastMissionResetAt DateTime?
  lastIdleClaimAt    DateTime?

  // 배고픔 게이지 계산용(SPEC.md 5절). 마지막으로 씨앗을 먹인 시각이다.
  // 배고픔 값 자체는 저장하지 않는다 — lib/pet.ts hungerFor()가 이 시각에서 계산한다.
  // null이면 아직 한 번도 먹이지 않은 것이고, 화면은 createdAt을 기준으로 쓴다.
  lastFedAt DateTime?

  attendanceTotal Int @default(0) // 누적 출석일. dayIndex 계산에 사용

  createdAt DateTime @default(now())

  missions      UserMission[]
  petSkins      UserPetSkin[]
  cosmetics     UserCosmetic[]
  posts         Post[]
  comments      Comment[]
  likes         PostLike[]
  chatMessages  ChatMessage[]
  attendance    AttendanceClaim[]
  diagnosis     DiagnosisSession[]
  meetupsHosted Meetup[]
  meetupJoins   MeetupParticipant[]
}

model DiagnosisSession {
  id          String       @id @default(cuid())
  userId      String
  answers     Json // [{ questionCode, choiceCode }] — 조기 종료 때문에 문항 수가 사용자마다 다르다
  indicators  Json? // 지표 14개. { ALONE: true, LOW_INCOME: false, ... }
  typeCode    TypeCode
  subTypeCode SubTypeCode?
  adjective   Adjective
  reasonText  String? // LLM이 생성한 근거 3줄
  completedAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, completedAt])
}

model Mission {
  id             String       @id @default(cuid())
  code           String       @unique
  scope          MissionScope
  typeCode       TypeCode? // STAGE일 때만 사용
  stage          Int? // 1~100 (prisma/seed/curriculum.ts. 2026-08-22에 3 → 100으로 늘렸다)
  title          String
  description    String
  rewardSeeds    Int          @default(0)
  rewardShards   Int          @default(0)
  rewardAffinity Int          @default(0)
  requiresPhoto  Boolean      @default(false)
  order          Int          @default(0)

  userMissions UserMission[]
}

model UserMission {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  resetKey    String // DAILY는 "2026-08-20", STAGE는 "STAGE"
  completedAt DateTime @default(now())
  photoKey    String? // S3 object key

  user    User    @relation(fields: [userId], references: [id])
  mission Mission @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId, resetKey])
  @@index([userId, resetKey])
}

model PetSkin {
  id       String   @id @default(cuid())
  name     String   @unique // 여우 / 북극여우 / 고양이 / 샴고양이 … 어미가 종족명이다. 시드 upsert 키
  typeCode TypeCode // 종족. 같은 값이면 같은 동물이고, 스킨 구매는 자기 종족으로 제한한다

  isDefault  Boolean @default(false) // 진단으로 지급되는 기본 외형
  stageCount Int     @default(3) // 시드는 전부 4를 박는다(2026-08-21, S3에 종당 4장). 이 기본값에 기대는 행은 없다

  effectType EffectType @default(NONE) // 외형 스킨은 전부 NONE
  effectPct  Int        @default(0) // 15 = +15%

  priceShards  Int? // 별조각 구매가. 스킨은 별조각 전용이다. 기본 외형은 null
  imageKeyBase String // S3 prefix. stageCount가 4면 뒤에 -1 -2 -3 -4를 붙인다

  // 프로필 원형(사이드바·내 계정 모달)에만 쓰는 아바타. imageKeyBase와 **출처가 다르다**
  // (2026-08-24 사용자 결정). 값은 Figma 시안 파일명 그대로 `fox_avatar` 같은 것이고
  // `/images/`와 `.png`는 lib/assets.ts의 avatarUrl()이 붙인다 — public/images에 커밋된
  // Amplify 정적 자산이라 CloudFront가 아니다(CloudFront에는 이 3장이 없다, 전부 403).
  //
  // 왜 imageKeyBase를 덮어쓰지 않았는가: 그 값 하나가 홈 마스코트·미션 카드·펫 성장
  // 4단계·스킨 상점까지 8곳을 먹인다. 아바타는 포즈 1장이라 -1~-4가 없어서 덮어쓰면
  // 성장 단계가 전부 같은 그림이 되거나 404로 이모지 폴백이 된다.
  //
  // null이면 호출부가 imageKeyBase 쪽 그림으로 되돌아간다 — 북극 변종은 아바타 그림이
  // 따로 없어 같은 종족 아바타를 쓴다(고양잇과 3종이 아니라 종족당 1장뿐이다).
  avatarKey String?

  owners      UserPetSkin[]
  activeUsers User[]        @relation("ActiveSkin")
}

model UserPetSkin {
  id         String   @id @default(cuid())
  userId     String
  petSkinId  String
  acquiredAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  petSkin PetSkin @relation(fields: [petSkinId], references: [id])

  @@unique([userId, petSkinId])
}

model CosmeticItem {
  id     String @id @default(cuid())
  name   String @unique // 시드 upsert 키
  slot   Slot
  rarity Rarity // 추첨 확률이 아니라 가격 기준이다. COMMON 50 / RARE 100 / EPIC 200 / LEGENDARY 400

  // 치장 아이템은 종족 구분이 없다. 전부 친밀도 전용이라 이 값은 항상 true다.
  affinityOnly  Boolean @default(false)
  priceAffinity Int?

  imageKey String

  owners UserCosmetic[]
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id])
  item CosmeticItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model AttendanceClaim {
  id        String   @id @default(cuid())
  userId    String
  claimDate DateTime @db.Date
  dayIndex  Int // 1~7. (attendanceTotal - 1) % 7 + 1

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, claimDate])
}

model Post {
  id String @id @default(cuid())

  // 작성 시점의 갤러리를 그대로 보관한다. 재진단으로 유형이 바뀌어도 글은 이동하지 않는다.
  // ALL은 "전체" 탭에 쓴 글. TypeCode가 아니라 GalleryType이라 전체 탭도 저장할 수 있다.
  galleryType GalleryType

  userId       String
  title        String
  body         String
  imageKey     String?
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  user     User       @relation(fields: [userId], references: [id])
  comments Comment[]
  likes    PostLike[]

  @@index([galleryType, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([postId, createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Meetup {
  id          String       @id @default(cuid())
  galleryType GalleryType
  hostId      String
  title       String
  body        String
  place       String
  startsAt    DateTime
  minCount    Int          @default(1)
  capacity    Int
  joinCount   Int          @default(0)
  status      MeetupStatus @default(OPEN)
  confirmedAt DateTime?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  host         User                @relation(fields: [hostId], references: [id])
  participants MeetupParticipant[]

  @@index([galleryType, startsAt])
  @@index([status, startsAt])
}

// 취소해도 행을 지우지 않고 canceledAt만 채운다.
// 하드 삭제하면 신청·취소 반복으로 친밀도를 무한히 받을 수 있다.
model MeetupParticipant {
  id         String    @id @default(cuid())
  meetupId   String
  userId     String
  joinedAt   DateTime  @default(now())
  canceledAt DateTime?

  // 모임이 무산됐다는 알림을 이 유저에게 보여준 시각. null이면 아직 안 보여줬다.
  notifiedCancelAt DateTime?

  // 본인이 신청을 취소할 때 고른 사유. 건너뛸 수 있으므로 null이 정상이다.
  // 필수로 만들지 않는다 — 취소를 어렵게 하면 말없이 안 나타나는 쪽으로 흐른다.
  cancelReason String?

  meetup Meetup @relation(fields: [meetupId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([meetupId, userId])
  @@index([userId])
}
